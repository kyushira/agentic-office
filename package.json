{
  "name": "agent-office",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Office: a read-only 3D office view of the Hermes agents, as a Hermes dashboard plugin.",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.harness.config.js",
    "test": "node --test test/*.test.js && /opt/hermes/.venv/bin/python -I -m unittest discover -s test -p 'test_*.py'"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "*",
    "vite": "*"
  }
}
